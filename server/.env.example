# ============================================================
#  题库大师 · 后端 AI 服务配置（复制为 .env 后即可使用）
# ============================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# 图片 base64 体积较大，适当放宽（字节）
MAX_BODY_BYTES=20971520

# ---------- 大模型（OpenAI 兼容协议，默认 DeepSeek）----------
OPENAI_BASE_URL=https://api.deepseek.com
# ⚠️ 本文件为示例模板：公开仓库中请勿填写真实 Key。
# 实际使用时复制为 server/.env 并填入你的 Key（server/.env 已被 .gitignore 忽略）。
OPENAI_API_KEY=sk-在这里填写你的密钥
LLM_MODEL=deepseek-flash
# deepseek-flash 属推理模型，会额外消耗 reasoning tokens，上限给足
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90

# 换服务商只改上面三行，例如：
# 通义千问: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 智谱:     OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-4-flash
# Moonshot: OPENAI_BASE_URL=https://api.moonshot.cn/v1                         LLM_MODEL=moonshot-v1-8k
# OpenAI:   OPENAI_BASE_URL=https://api.openai.com/v1                          LLM_MODEL=gpt-4o-mini
# Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1                          LLM_MODEL=qwen2.5:7b

# ⚠️ 本文件含真实 API Key，仅供自用；公开仓库前请删除 Key 值或改走服务端环境变量注入。
